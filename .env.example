# Copy to teamvault.env (read from the working directory) or export these. Real env vars win over the file.

# Where tokens, the spool and the vault live. The vault is <data>/tenants/<team>/vault (a git repo).
TEAMVAULT_DATA=./data
TEAMVAULT_TEAM=default

# Bind address. Keep 127.0.0.1 behind a reverse proxy; PUBLIC_URL is the address clients use.
TEAMVAULT_HOST=127.0.0.1
TEAMVAULT_PORT=8790
TEAMVAULT_PUBLIC_URL=http://127.0.0.1:8790

# Librarian: "claude" (headless Claude Code reviews and files every write) or "naive" (no model; facts go
# verbatim to areas/unsorted.md).
TEAMVAULT_LIBRARIAN=claude
TEAMVAULT_CLAUDE_BIN=claude
TEAMVAULT_MODEL=opus
TEAMVAULT_DAILY_CAP=60
# Optional: a shell command that exits 0 while another job should go first; the librarian waits.
TEAMVAULT_BUSY_CMD=

# Credentials for the librarian's Claude Code (one of the two). Only these are passed to the subprocess.
# CLAUDE_CODE_OAUTH_TOKEN=    (from `claude setup-token`)
# ANTHROPIC_API_KEY=
